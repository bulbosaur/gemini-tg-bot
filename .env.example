# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample

# Ключ Google Gemini из Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaExampleExampleExampleExampleExample

# Необязательные настройки
GEMINI_MODEL=gemini-2.5-flash
# Сколько последних сообщений диалога держать в памяти (по умолчанию 20)
HISTORY_LIMIT=20
# Таймаут одного запроса к Gemini в секундах (по умолчанию 120)
REQUEST_TIMEOUT=120
# Системная инструкция: задаёт стиль ответов
SYSTEM_PROMPT=Ты — полезный ассистент в Telegram. Отвечай на языке пользователя, кратко и по существу.
# Уровень логирования: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
